# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=mysql+aiomysql://root:your_password@localhost:3306/stocksense
DATABASE_URL_SYNC=mysql+pymysql://root:your_password@localhost:3306/stocksense

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis_secret
REDIS_URL=redis://:redis_secret@localhost:6379/0

# ─── Backend Auth ─────────────────────────────────────────────────────────────
# IMPORTANT: Generate a secure random secret for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── AI Features (Optional) ──────────────────────────────────────────────────
# Set this to enable the AI assistant. Without it, a rule-based fallback is used.
OPENAI_API_KEY=

# ─── Environment ─────────────────────────────────────────────────────────────
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
